# URL pública del backend (taskpro-backend en Railway).
# Vite la inyecta en tiempo de BUILD, así que debe existir antes de "npm run build".
VITE_API_URL=https://taskpro-backend-production.up.railway.app

# Google OAuth (opcional). Sin este valor el login con Google no funciona.
VITE_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
