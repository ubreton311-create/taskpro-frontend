# Copy to .env.local for local development:  cp .env.example .env.local
#
# VITE_* values are inlined into the public bundle at BUILD time. Never put a
# secret in this file. Full guide (local / production / preview / CI):
# docs/environment.md

# Base URL of the TaskPro API, no trailing slash.
# REQUIRED for production builds: `npm run build` fails without it (see
# vite.config.ts and DEPLOY.md). In local development it falls back to
# http://localhost:3000 when unset.
VITE_API_URL=https://taskpro-backend-production.up.railway.app

# Google OAuth web client id (public identifier, safe to expose).
# Optional: when unset, the "Continuar con Google" button is hidden.
VITE_GOOGLE_CLIENT_ID=

# Public support channels shown in the Servicio al Cliente screen.
# Optional: any channel left empty is hidden, so the UI never shows a
# placeholder phone number or a WhatsApp link that reaches nobody.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_WHATSAPP=
